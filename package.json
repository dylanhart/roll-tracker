    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^22.15.29",
    "fflate": "^0.8.2",
    "handlebars": "4.7.8",
    "pixi.js": "7.4.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "tsx": "^4.20.6"
  }
}
