{
  "name": "roll-tracker",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dev": "vite build --watch",
    "test": "node --import tsx --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/jquery": "^3.5.32",
    "@types/node": "^22.15.29",
    "fflate": "^0.8.2",
    "handlebars": "4.7.8",
    "pixi.js": "7.4.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
