{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@common/*": [
        "./vendor/pf2e/types/foundry/common/*"
      ],
      "@client/*": [
        "./vendor/pf2e/types/foundry/client/*"
      ]
    },
    "types": [
      "jquery",
      "node"
    ]
  },
  "include": [
    "src",
    "vendor/pf2e/types/foundry/global-external.d.mts",
    "vite.config.ts"
  ]
}
